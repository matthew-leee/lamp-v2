# Reverse proxy and automatic HTTPS for the storefront & API (OPS-01).
{$SITE_DOMAIN:localhost} {
    encode zstd gzip

    # Stripe webhook & API health probes go straight to the Rust API.
    handle /api/webhooks/stripe {
        reverse_proxy api:8080
    }
    handle /health {
        reverse_proxy api:8080
    }

    # All customer storefront and admin studio routes go to the Next.js server,
    # which relays admin and availability requests over the private Docker network.
    handle {
        reverse_proxy web:3002
    }
}

# Internal HTTP origin for Cloudflare Tunnel (no HTTP->HTTPS redirect loop).
:8080 {
    encode zstd gzip

    handle /api/webhooks/stripe {
        reverse_proxy api:8080
    }
    handle /health {
        reverse_proxy api:8080
    }
    handle {
        reverse_proxy web:3002
    }
}
