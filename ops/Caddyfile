# Reverse proxy and automatic HTTPS for the storefront & API (OPS-01).
{$SITE_DOMAIN:localhost} {
    encode zstd gzip

    # The Stripe webhook goes through the Next.js webhook route
    # (web/app/api/webhooks/stripe/route.ts): it settles the order in the Rust
    # API AND then sends the paid email + revalidates the cache — a webhook-only
    # settlement (the buyer never returns to the site) must do all three, which
    # only the web tier can.
    handle /api/webhooks/stripe {
        reverse_proxy web:3002
    }
    # API health probes go straight to the Rust API.
    handle /health {
        reverse_proxy api:8080
    }

    # All customer storefront and admin studio routes go to the Next.js server,
    # which relays admin and availability requests over the private Docker network.
    handle {
        reverse_proxy web:3002
    }
}

# Internal HTTP origin for Cloudflare Tunnel (no HTTP->HTTPS redirect loop).
:8080 {
    encode zstd gzip

    handle /api/webhooks/stripe {
        reverse_proxy web:3002
    }
    handle /health {
        reverse_proxy api:8080
    }
    handle {
        reverse_proxy web:3002
    }
}
