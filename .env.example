# Root environment template for docker-compose (ENV-01, NAME-01, CONFIG-01).
# Copy to .env and supply deployment values. Never commit .env or real secrets.

# --- Database (Postgres 17) ---
POSTGRES_USER=storefront
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=storefront

# --- Company & White-Label Identity (ENV-01 / NAME-01) ---
NEXT_PUBLIC_BRAND_NAME=YOUR_BRAND_NAME
NEXT_PUBLIC_BRAND_NAME_NATIVE=
NEXT_PUBLIC_SITE_URL=https://shop.example.com
SITE_DOMAIN=shop.example.com
STAGING_SITE_DOMAIN=staging.shop.example.com
NEXT_PUBLIC_CURRENCY=HKD
NEXT_PUBLIC_LOCALES=en,zh-HK
NEXT_PUBLIC_WHATSAPP_NUMBER=
NEXT_PUBLIC_FPS_ID=
NEXT_PUBLIC_FPS_ACCOUNT_NAME=
NEXT_PUBLIC_FPS_QR_URL=

# --- Analytics & Search Console (GA-OFF-01: leave empty to keep OFF) ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GSC_VERIFICATION=

# --- Operational & Freshness Knobs ---
MAX_POOL_CONNECTIONS=10
NEXT_PUBLIC_AVAILABILITY_TTL_MS=60000
NEXT_PUBLIC_FETCH_TIMEOUT_MS=10000
NEXT_PUBLIC_CONTENT_REVALIDATE_SECONDS=60
CARD_RESERVATION_TTL_MINS=30
FPS_RESERVATION_TTL_HOURS=24

# --- Admin & Payment Gateway Secrets (Server-Only, Never in DB) ---
SESSION_SECRET=replace-with-at-least-32-bytes-of-random-entropy
ADMIN_USERNAME=
ADMIN_PASSWORD=
SESSION_COOKIE_SECURE=true
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Transactional Email Delivery (EMAIL-01: Resend API or SMTP) ---
RESEND_API_KEY=
EMAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# --- Off-Box Backups (Cloudflare R2, optional) ---
BACKUP_DIR=/var/backups/storefront
R2_BUCKET=
R2_ENDPOINT_URL=
